# ==========================================
# 1. 依赖包与包管理器缓存
# ==========================================
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 2. 编译产物与安装包输出
# ==========================================
out/
dist/
release/
release-new/
*.blockmap

# ==========================================
# 3. 编译缓存与工具临时目录
# ==========================================
*.tsbuildinfo
.vite/
.turbo/
.cache/
.eslintcache

# ==========================================
# 4. 外部运行时引擎（体积较大，通过 pnpm vendor:fetch 拉取）
# ==========================================
resources/vendor/*
!resources/vendor/.gitkeep
_vendor/

# ==========================================
# 5. 本地环境变量、证书与私钥（严禁入库）
# ==========================================
.env
.env.*
!.env.example
*.pfx
*.p12
*.key

# ==========================================
# 6. 日志与本地测试目录
# ==========================================
logs/
*.log
_test-downloads/
tmp/
temp/

# ==========================================
# 7. 操作系统与编辑器无关文件
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
